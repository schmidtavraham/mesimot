# העתק ל-bot/.env והכנס ערכים אמיתיים.

# טוקן הבוט מ-@BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Supabase project URL וה-Service Role Key (חשוב: זה הסוד האדמין - אסור להעלות אותו ל-Frontend או ל-Git!)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# רשימת chat IDs מורשים, מופרדים בפסיקים. רק הם יוכלו להוסיף משימות.
# כדי לדעת את ה-chat ID שלך - שלח /start לבוט והוא יחזיר לך אותו.
ALLOWED_CHAT_IDS=
