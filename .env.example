# העתק את הקובץ הזה ל-.env והכנס את הערכים האמיתיים.
# הערכים האלה משמשים את ה-React app בלבד (Vite חושף רק משתנים שמתחילים ב-VITE_).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# Web Push (Public VAPID key only — את ה-PRIVATE שומרים ב-Supabase כ-Edge Function secret).
# צור צמד מפתחות חדש עם: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
